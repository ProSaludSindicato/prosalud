APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=960

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ProSanet Employees API (primary affiliate data source; Excel is fallback)
PROSANET_API_ENABLED=true
PROSANET_API_BASE_URL=https://api.prosanet.aksingeneo.net/index.php
PROSANET_API_USERNAME=
PROSANET_API_PASSWORD=
PROSANET_API_TIMEOUT=15
PROSANET_API_TOKEN_CACHE_TTL=1320 # 22 horas

FRONTEND_URL=https://localhost:8080
# Orígenes de este entorno, separados por coma. En local, añade la IP de LAN si pruebas desde un dispositivo.
CORS_ALLOWED_ORIGINS=https://localhost:8080,http://localhost:8080

# reCAPTCHA Enterprise (deshabilitar en local si hay problemas de red/DNS con Google)
RECAPTCHA_ENABLED=true
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_PROJECT_ID=

# Convenios: production (email a afiliados) | cualquier otro valor = TEST (email al usuario, historial marcado)
CONVENIO_DELIVERY_MODE=production
# Disco S3 privado (Laravel Cloud sobreescribe prosalud-private). PDFs original/firmado/final.
CONVENIO_STORAGE_DISK=prosalud-private
CONVENIO_EMAILS_PER_MINUTE=30
CONVENIO_PROSANET_PER_MINUTE=20
CONVENIO_ZIP_MAX_KB=51200
CONVENIO_ZIP_MAX_PDFS=200

# PHP must allow uploads at least this large (post_max_size >= upload_max_filesize).
# Local Herd/Valet: ensure php-memory-limits.ini exists for your PHP version or restart after changing public/.user.ini

WORDTOPDF_ENABLED=true
WORDTOPDF_BASE_URL=https://tu-servidor-contabo.com
WORDTOPDF_API_KEY=tu-api-key-segura
WORDTOPDF_TIMEOUT=120
WORDTOPDF_CONNECT_TIMEOUT=10
# Protección owner-password en certificados y otros PDF. Los convenios de afiliación siempre se generan sin protección.
WORDTOPDF_PROTECT_PDF=true
WORDTOPDF_VERIFY_SSL=true

# Autofirma del presidente (microservicio Contabo). El secreto es el mismo AUTO_SIGN_API_KEY del VPS.
AUTO_SIGN_ENABLED=false
AUTO_SIGN_URL=https://auto-sign.tudominio.com
AUTO_SIGN_API_KEY=
AUTO_SIGN_TIMEOUT=60
AUTO_SIGN_CONNECT_TIMEOUT=10
AUTO_SIGN_VERIFY_SSL=true
AUTO_SIGN_SEARCH_TEXT="JORGE IVAN ÁLVAREZ SOTO"
AUTO_SIGN_SECONDARY_ANCHOR=PRESIDENTE
AUTO_SIGN_SEARCH_PAGE=2
AUTO_SIGN_STAMP_WIDTH=48
AUTO_SIGN_STAMP_HEIGHT=63
AUTO_SIGN_OFFSET_X=0
AUTO_SIGN_OFFSET_Y=-20
AUTO_SIGN_SIGNATURE_PATH=resources/signatures/presidente.png
AUTO_SIGN_PER_MINUTE=8

# Firma masiva del presidente (modal por todos/fechas en el panel). Requiere AUTO_SIGN_ENABLED.
CONVENIO_PRESIDENT_SIGN_BULK_ENABLED=false
# Si true, tras autofirma queda pendiente de revisión antes de completar y enviar correo.
CONVENIO_PRESIDENT_SIGN_REQUIRE_REVIEW=true
CONVENIO_PRESIDENT_SIGN_BULK_MAX=1000

# CloudConvert (fallback DOCX→PDF si WordToPdf API no está disponible)
# Obtén tu API key en https://cloudconvert.com/dashboard/api/v2/keys
CLOUDCONVERT_API_KEY=
